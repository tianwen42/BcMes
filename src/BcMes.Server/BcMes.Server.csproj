    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.*" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
    <PackageReference Include="TDengine.Connector" Version="3.2.1" />
  </ItemGroup>

</Project>
